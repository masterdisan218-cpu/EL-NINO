{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30
    },
    "api/admin/[...path].js": {
      "maxDuration": 30
    },
    "api/admin/content/[...path].js": {
      "maxDuration": 30
    },
    "api/analytics/[...path].js": {
      "maxDuration": 30
    },
    "api/auth/[...path].js": {
      "maxDuration": 30
    },
    "api/public/[...path].js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
